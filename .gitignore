# Ballerina build artifacts
**/target/
**/generated/

# Local runtime configuration — never commit real secrets
**/Config.toml

# Certificates and private keys — mount as Choreo file secrets at runtime
**/resources/*.key
**/resources/*.crt

# Local environment / secrets files
.env
**/.env
.env.local

# Per-developer / local-only state
deployment-values.local.md
**/deployment-values.local.md
.claude/
**/.claude/

# Java / JVM artifacts (Ballerina compiles to JVM bytecode)
*.class
*.log
.mtj.tmp/
*.ctxt

# Java packaging
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# JVM crash logs
hs_err_pid*
replay_pid*

# Editor / IDE
.idea/
.vscode/

# OS junk
.DS_Store
Thumbs.db
